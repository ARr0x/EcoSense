    "TableInput": {
     "Description": "EcoSense IoT telemetry — partitioned by year/month/day/hour",
     "Name": "telemetry",
     "Parameters": {
      "classification": "json",
      "projection.enabled": "true",
      "projection.year.type": "integer",
      "projection.year.range": "2026,2030",
      "projection.month.type": "integer",
      "projection.month.range": "1,12",
      "projection.month.digits": "2",
      "projection.day.type": "integer",
      "projection.day.range": "1,31",
      "projection.day.digits": "2",
      "projection.hour.type": "integer",
      "projection.hour.range": "0,23",
      "projection.hour.digits": "2",
      "storage.location.template": "s3://ecosense-archives-836005851254-us-east-1/${year}-${month}-${day}-${hour}"
     },
     "PartitionKeys": [
      {
       "Name": "year",
       "Type": "int"
      },
      {
       "Name": "month",
       "Type": "int"
      },
      {
       "Name": "day",
       "Type": "int"
      },
      {
       "Name": "hour",
       "Type": "int"
      }
     ],
     "StorageDescriptor": {
      "Columns": [
       {
        "Name": "sensor_id",
        "Type": "string"
       },
       {
        "Name": "metric",
        "Type": "string"
       },
       {
        "Name": "value",
        "Type": "double"
       },
       {
        "Name": "unit",
        "Type": "string"
       },
       {
        "Name": "status",
        "Type": "string"
       },
       {
        "Name": "region",
        "Type": "string"
       },
       {
        "Name": "quartier",
        "Type": "string"
       },
       {
        "Name": "timestamp",
        "Type": "bigint"
       }
      ],
      "InputFormat": "org.apache.hadoop.mapred.TextInputFormat",
      "Location": "s3://ecosense-archives-836005851254-us-east-1/",
      "OutputFormat": "org.apache.hadoop.hive.ql.io.HiveIgnoreKeyTextOutputFormat",
      "SerdeInfo": {
       "Parameters": {
        "ignore.malformed.json": "true"
       },
       "SerializationLibrary": "org.openx.data.jsonserde.JsonSerDe"
      }
     },
     "TableType": "EXTERNAL_TABLE"
