# ============================================================
# .env — EcoSense (racine du dépôt)
# ============================================================

# === AWS (commun à CDK et simulator) ===
AWS_ACCOUNT_ID=123456789012
CDK_DEFAULT_REGION=us-east-1
SECONDARY_REGION=us-east-2

# === IoT Core (à remplir APRÈS cdk deploy) ===
# Récupérer avec : aws iot describe-endpoint --endpoint-type iot:Data-ATS
IOT_ENDPOINT_PRIMARY=abc123xyz.iot.us-east-1.amazonaws.com
IOT_ENDPOINT_SECONDARY=abc123xyz.iot.us-east-2.amazonaws.com

# === Identité MQTT (doit matcher la policy générée par provision_certs.py) ===
MQTT_CLIENT_ID=ecosense-simulator

# === Simulation ===
SENSOR_COUNT=500
BURST_SIZE=50
BURST_INTERVAL=1.0
CRITICAL_RATE=0.1
LOG_LEVEL=INFO