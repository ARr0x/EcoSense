# ==============================================================================
# .env.example — EcoSense
# Copier vers .env et remplir les valeurs
# NE JAMAIS committer .env
# ==============================================================================

# === AWS ======================================================================
# Récupérer depuis la console AWS (en haut à droite, format: 123456789012)
AWS_ACCOUNT_ID=123456789012

# Régions de déploiement
CDK_DEFAULT_REGION=us-east-1
SECONDARY_REGION=us-west-2

# Activer le déploiement et le failover multi-région (true/false)
# false → seuls les stacks Primary sont déployés, failover simulateur désactivé
MULTI_REGION=false

# === SNS Alertes ==============================================================
# Email qui recevra les alertes CRITICAL
# ⚠ Après cdk deploy, AWS envoie un mail de confirmation à cette adresse
# → Cliquer "Confirm subscription" avant de lancer le simulateur
ALERT_EMAIL=team@example.com

# === IoT Core (à remplir APRÈS cdk deploy) ====================================
# Récupérer avec :
#   aws iot describe-endpoint --endpoint-type iot:Data-ATS --region us-east-1
#   aws iot describe-endpoint --endpoint-type iot:Data-ATS --region us-west-2
IOT_ENDPOINT_PRIMARY=
IOT_ENDPOINT_SECONDARY=

# Client ID MQTT — doit matcher la IoT Policy générée par provision_certs.py
MQTT_CLIENT_ID=ecosense-simulator

# === S3 / Firehose ============================================================
# Préfixe du bucket S3 (nom complet : {prefix}-{account}-{region})
S3_BUCKET_PREFIX=ecosense-archives

# Firehose buffer : écrire en S3 toutes les N secondes (min 60, max 900)
FIREHOSE_BUFFER_SECONDS=60

# Firehose buffer : écrire en S3 quand le buffer atteint N MB (min 1, max 128)
FIREHOSE_BUFFER_MB=5

# === Alertes & agrégation =====================================================
# Délai (secondes) avant le premier email groupé après une alerte CRITICAL
# Valeur basse (ex: 30) pour les démos, valeur haute (ex: 300) pour la prod
FIRST_INTERVAL_SEC=300

# === Simulateur ===============================================================
SENSOR_COUNT=500
BURST_SIZE=50
BURST_INTERVAL=1.0

# Probabilité qu'un message soit CRITICAL (0.0 à 1.0)
CRITICAL_RATE=0.1

# === Route 53 Health Checks (à remplir APRÈS make deploy-route53) =============
# Récupérer avec : make deploy-route53 (outputs CDK) ou via la console Route 53
# Si vides, le polling Route 53 est désactivé (failover réactif MQTT uniquement)
ROUTE53_HC_ID_PRIMARY=
ROUTE53_HC_ID_SECONDARY=

# Vérifier l'état Route 53 toutes les N salves (~N secondes à BURST_INTERVAL=1s)
HEALTH_POLL_BURSTS=30
