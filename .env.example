# ==============================================================================
# .env.example — EcoSense
# Copier vers .env et remplir les valeurs
# NE JAMAIS committer .env
# ==============================================================================

# === AWS ======================================================================
# Récupérer depuis la console AWS (en haut à droite, format: 123456789012)
AWS_ACCOUNT_ID=123456789012

# Régions de déploiement
CDK_DEFAULT_REGION=us-east-1
SECONDARY_REGION=us-east-2

# === SNS Alertes ==============================================================
# Email qui recevra les alertes CRITICAL
# ⚠ Après cdk deploy, AWS envoie un mail de confirmation
# → Cliquer "Confirm subscription" avant la démo
ALERT_EMAIL=team@example.com

# === IoT Core (à remplir APRÈS cdk deploy) ====================================
# Récupérer avec :
#   aws iot describe-endpoint --endpoint-type iot:Data-ATS --region us-east-1
#   aws iot describe-endpoint --endpoint-type iot:Data-ATS --region us-east-2
IOT_ENDPOINT_PRIMARY=
IOT_ENDPOINT_SECONDARY=

# Client ID MQTT — doit matcher la IoT Policy générée par provision_certs.py
MQTT_CLIENT_ID=ecosense-simulator

# === S3 / Firehose ============================================================
# Préfixe du bucket S3 (nom complet : {prefix}-{account}-{region})
S3_BUCKET_PREFIX=ecosense-archives

# Firehose buffer : écrire en S3 toutes les N secondes (min 60, max 900)
FIREHOSE_BUFFER_SECONDS=60

# Firehose buffer : écrire en S3 quand le buffer atteint N MB (min 1, max 128)
FIREHOSE_BUFFER_MB=5

# === Simulateur ===============================================================
SENSOR_COUNT=500
BURST_SIZE=50
BURST_INTERVAL=1.0

# Probabilité qu'un message soit CRITICAL (0.0 à 1.0)
CRITICAL_RATE=0.1

# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
